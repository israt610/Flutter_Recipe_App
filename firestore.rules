rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents: Only document owner can read & write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Recipes collection: Authenticated users can read, client writes restricted
    match /recipes/{recipeId} {
      allow read: if request.auth != null;
      allow write: if false; // Disallow client writes until Phase 4 admin features
    }
  }
}
